        <property name="contrast" type="checkbox" colspan="3">
            <meta>
                <title>accessibility_settings.contrast</title>
            </meta>
            <params>
                <param name="default_value" value="false"/>
            </params>
        </property>

        <property name="dyslexiaFont" type="checkbox" colspan="3">
            <meta>
                <title>accessibility_settings.dyslexiaFont</title>
            </meta>
            <params>
                <param name="default_value" value="false"/>
            </params>
        </property>

        <property name="lineHeight" type="checkbox" colspan="3">
            <meta>
                <title>accessibility_settings.lineHeight</title>
            </meta>
            <params>
                <param name="default_value" value="false"/>
            </params>
        </property>
